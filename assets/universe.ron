#![enable(implicit_some)]
// Das Universum von Zorbel Space Program.
//
// Galaxie → Sternsysteme → Stern → Planeten → Monde. Alle Systeme teilen
// dieselben Achsen. Bahnwinkel in rad, Längen in m, μ = G·M in m³/s².
// Die Einflusssphären werden aus den Massen berechnet.
// Zwischen Systemen wird gesprungen, nur aus dem Sprungring um den Stern.
(
    systems: [
        (
            name: "Zol",
            position_ly: (0.0, 0.0, 0.0),
            velocity: (0.0, 0.0, 0.0),
            jump_zone: (2.0e9, 4.0e9),
            star: (
                name: "Zun",
                mu: 1.1723328e18,
