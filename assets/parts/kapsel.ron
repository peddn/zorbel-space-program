// Kommandokapsel (Kegelstumpf). Wurzel jedes Schiffs, liefert Lageregelung per Reaktionsrad.
(
    id: "kapsel",
    name: "Kapsel",
    dry_mass: 800.0,                  // kg
    attach: Stack,
    shape: Cone(radius_bottom: 0.625, radius_top: 0.25, length: 1.2),
    node_strength: (tension: 300000.0, compression: 1200000.0, shear: 250000.0, bending: 400000.0, torsion: 150000.0),
    crash_tolerance: 12.0,              // m/s Aufprall am Boden
    modules: [
        Command(torque: 5000.0),       // N·m pro Achse
    ],
)
