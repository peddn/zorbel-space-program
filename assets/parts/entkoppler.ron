// Stapel-Entkoppler. Trennt beim Auslösen die Verbindung zu seinem Elternteil (oben);
// er selbst bleibt an der abgeworfenen Unterstufe.
(
    id: "entkoppler",
    name: "Entkoppler",
    dry_mass: 50.0,
    attach: Stack,
    shape: Cylinder(radius: 0.625, length: 0.2),
    node_strength: (tension: 200000.0, compression: 1200000.0, shear: 200000.0, bending: 300000.0, torsion: 120000.0),
    crash_tolerance: 8.0,              // m/s Aufprall am Boden
    modules: [
        Decoupler(eject_impulse: 2500.0),   // N·s, wirkt entgegengesetzt auf beide Teile
    ],
)
